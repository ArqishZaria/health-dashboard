# Copy this file to .env and adjust values for your environment.

DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
DJANGO_TIME_ZONE=Asia/Karachi

# --- Database -----------------------------------------------------------
# Leave DJANGO_DB_ENGINE unset (or =sqlite) to use SQLite for local dev/testing.
# Set DJANGO_DB_ENGINE=postgres and fill in the values below to use PostgreSQL.
DJANGO_DB_ENGINE=sqlite
POSTGRES_DB=health_dms
POSTGRES_USER=health_dms
POSTGRES_PASSWORD=health_dms
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
